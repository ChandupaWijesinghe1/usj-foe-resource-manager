# ==============================================================================
# Production Environment Variables - USJ FOE Backend
# ==============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Production PostgreSQL Database Connection
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>?ssl=require
POSTGRES_USER=usj_admin
POSTGRES_PASSWORD=replace_with_strong_production_db_password
POSTGRES_SERVER=db-cluster.usj.ac.lk
POSTGRES_PORT=5432
POSTGRES_DB=usj_resource_prod_db
DATABASE_URL=postgresql+asyncpg://usj_admin:replace_with_strong_production_db_password@db-cluster.usj.ac.lk:5432/usj_resource_prod_db?ssl=require

# JWT Cryptographic Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_openssl_generated_64_character_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Institutional Domain Verification
ALLOWED_EMAIL_DOMAINS=["eng.sjp.ac.lk","sjp.ac.lk"]
ENFORCE_EMAIL_DOMAIN=true

# Secure Production CORS Origins (Add production custom domains and previews)
BACKEND_CORS_ORIGINS=["https://resources.eng.sjp.ac.lk","https://usj-foe-resource-manager.vercel.app"]

# Security & Rate Limiting
RATE_LIMITING_ENABLED=true
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/var/data/uploads
