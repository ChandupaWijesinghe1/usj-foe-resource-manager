# =============================================================================
# Git Ignore Configuration - USJ FOE Resource Management System
# =============================================================================

# 1. Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env
!.env.example
!backend/.env.example
!backend/.env.production.example

# 2. Node & Frontend Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Next.js Build Outputs & Cache
.next/
frontend/.next/
out/
frontend/out/
build/
dist/

# 4. Python & Virtual Environments
venv/
.venv/
env/
backend/venv/
backend/.venv/
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 5. Testing & Coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.nyc_output/
coverage/

# 6. Databases & Local SQLite files
*.sqlite
*.sqlite3
*.db
api.sqlite

# 7. Uploaded Media & Temporary Files
backend/uploads/*
!backend/uploads/.gitkeep
uploads/
tmp/
temp/

# 8. OS & Editor Artifacts
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 9. Log Files
*.log
logs/
config.bat
